# ============================================================
# Wedding Memories Uploader - Deployment Configuration
# ============================================================

# 1. Google Apps Script Project ID (Required)
# Found in: script.google.com -> Project Settings (gear icon on left) -> Script ID
SCRIPT_ID=your_script_id_here

# 2. Target Google Drive Folder ID (Required)
# Found in the URL of your Google Drive folder:
# https://drive.google.com/drive/folders/YOUR_TARGET_FOLDER_ID
TARGET_FOLDER_ID=your_google_drive_folder_id_here

# 3. Web App Deployment ID (Optional, but highly recommended)
# Found in: script.google.com -> Deploy -> Manage deployments -> Deployment ID
# Providing this updates your existing deployment in-place, keeping the exact
# same Web App URL and QR code unchanged for guests!
DEPLOYMENT_ID=
